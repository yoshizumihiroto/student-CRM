generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProposalStatus {
  PROPOSED
  REQUESTED
  CONFIRMED
}

enum SelectionStatus {
  ENTRY            // エントリー
  DOCUMENT         // 書類選考
  FIRST_INTERVIEW  // 一次面接
  SECOND_INTERVIEW // 二次面接
  FINAL_INTERVIEW  // 最終面接
  OFFER            // 内定
  REJECTED         // お見送り
}

enum Aspiration {
  HIGH   // 高
  MEDIUM // 中
  LOW    // 低
}

model Ca {
  id        String     @id @default(cuid())
  name      String
  students  Student[]
  proposals Proposal[]
}

model Student {
  id           String               @id @default(cuid())
  name         String
  ca           Ca?                  @relation(fields: [caId], references: [id])
  caId         String?
  proposals    Proposal[]
  applications Application[]
  visionScores StudentVisionScore[]
}

// キャリアビジョンの評価軸（価値観・役割・成長機会・勤務条件）
model VisionItem {
  id            String               @id @default(cuid())
  key           String               @unique
  label         String
  category      String
  order         Int
  studentScores StudentVisionScore[]
  companyScores CompanyVisionScore[]
}

// 学生が各軸に設定する重要度（1〜5）
model StudentVisionScore {
  id         String     @id @default(cuid())
  student    Student    @relation(fields: [studentId], references: [id])
  studentId  String
  item       VisionItem @relation(fields: [itemId], references: [id])
  itemId     String
  importance Int

  @@unique([studentId, itemId])
}

// 企業の各軸の充実度（1〜5）
model CompanyVisionScore {
  id        String     @id @default(cuid())
  company   Company    @relation(fields: [companyId], references: [id])
  companyId String
  item      VisionItem @relation(fields: [itemId], references: [id])
  itemId    String
  score     Int

  @@unique([companyId, itemId])
}

model Company {
  id           String               @id @default(cuid())
  name         String
  type         String?
  sessions     InfoSession[]
  proposals    Proposal[]
  visionScores CompanyVisionScore[]
}

model InfoSession {
  id        String     @id @default(cuid())
  company   Company    @relation(fields: [companyId], references: [id])
  companyId String
  startsAt  DateTime
  location  String
  capacity  Int
  remaining Int
  proposals Proposal[]
}

model Application {
  id          String          @id @default(cuid())
  student     Student         @relation(fields: [studentId], references: [id])
  studentId   String
  companyName String
  status      SelectionStatus @default(ENTRY)
  aspiration  Aspiration      @default(MEDIUM)
  nextDate    DateTime?
  memo        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Proposal {
  id              String         @id @default(cuid())
  student         Student        @relation(fields: [studentId], references: [id])
  studentId       String
  company         Company        @relation(fields: [companyId], references: [id])
  companyId       String
  ca              Ca             @relation(fields: [caId], references: [id])
  caId            String
  status          ProposalStatus @default(PROPOSED)
  chosenSession   InfoSession?   @relation(fields: [chosenSessionId], references: [id])
  chosenSessionId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}
